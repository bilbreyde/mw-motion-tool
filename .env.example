# Azure AI Foundry
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-resource.openai.azure.com/
AZURE_FOUNDRY_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Azure Cosmos DB (session persistence)
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE=motion-tool
COSMOS_CONTAINER=sessions

# Azure Functions (backend)
FUNCTIONS_WORKER_RUNTIME=node
AzureWebJobsStorage=UseDevelopmentStorage=true

# Frontend (Vite) - prefix with VITE_ to expose to browser
VITE_API_BASE_URL=http://localhost:7071
